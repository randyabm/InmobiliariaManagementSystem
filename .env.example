# Plantilla de variables de entorno. Copia a `.env` y rellena los valores.
# NUNCA se commitea un `.env` real (.gitignore lo excluye, CHECKPOINTS.md §C7).
# Los valores de abajo son PLACEHOLDERS, no credenciales.

# --- Aplicación (apps/api) -------------------------------------------------
NODE_ENV=development
PORT=3000

# Lista explícita de orígenes permitidos, separados por comas.
# PROHIBIDO usar `*`: el CORS es por dominio de tenant (D7, RF-INT4, R18).
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=inmobiliaria
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# Cadena de conexión que consume la API. Debe coincidir con las variables de
# arriba cuando se usa el stack de `docker-compose.yml`.
DATABASE_URL=postgres://CHANGE_ME:CHANGE_ME@localhost:5432/inmobiliaria

# --- Redis -----------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379
REDIS_URL=redis://:CHANGE_ME@localhost:6379

# --- MinIO (object storage, D6) --------------------------------------------
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000

# --- Auth / JWT ------------------------------------------------------------
# Generado por init.sh. NO lo edites manualmente ni lo commitees.
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION=3600
