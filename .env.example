# Plantilla de variables de entorno. Copia a `.env` y rellena los valores.
# NUNCA se commitea un `.env` real (.gitignore lo excluye, CHECKPOINTS.md §C7).
# Los valores de abajo son PLACEHOLDERS, no credenciales.

# --- Aplicación (apps/api) -------------------------------------------------
NODE_ENV=development
PORT=3000

# Lista explícita de orígenes permitidos, separados por comas.
# PROHIBIDO usar `*`: el CORS es por dominio de tenant (D7, RF-INT4, R18).
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL ------------------------------------------------------------
# DOS ROLES, A PROPOSITO (D-10, R43/R47). Separar quien migra de quien sirve es
# lo que hace que el Row-Level Security deje de ser decorativo:
# `FORCE ROW LEVEL SECURITY` alcanza al dueño de la tabla, pero NO a un
# superusuario ni a un rol con BYPASSRLS. Si la API se conecta con el usuario
# del contenedor —que es superusuario—, el aislamiento por tenant no lo aplica
# nadie en ejecución. La aplicación se NIEGA A ARRANCAR si detecta que su rol
# puede saltarse el RLS (R44), así que esto no se puede desactivar en silencio.

# 1) Rol privilegiado: dueño del esquema. Solo migraciones y provisión.
POSTGRES_DB=inmobiliaria
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# Cadena que usan `npm run db:migrate` y la provisión del rol de aplicación.
# Debe coincidir con las variables de arriba con el stack de `docker-compose.yml`.
DATABASE_MIGRATION_URL=postgres://CHANGE_ME:CHANGE_ME@localhost:5432/inmobiliaria

# 2) Rol de aplicación: NOSUPERUSER, NOBYPASSRLS, no dueño de las tablas y sin
#    privilegio DELETE en ninguna (R45; todas las bajas son lógicas). Lo crea
#    `asegurarRolDeAplicacion` después de cada migración (R46), con estas
#    credenciales.
APP_DB_USER=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME

# Cadena que consume la API en ejecución normal. NUNCA la del rol privilegiado.
DATABASE_URL=postgres://CHANGE_ME:CHANGE_ME@localhost:5432/inmobiliaria

# --- Redis -----------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379
REDIS_URL=redis://:CHANGE_ME@localhost:6379

# --- MinIO (object storage, D6) --------------------------------------------
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000

# --- Auth / JWT ------------------------------------------------------------
# Generado por init.sh. NO lo edites manualmente ni lo commitees.
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION=3600
