# Plantilla de variables de entorno para el stack de CI (Forgejo + runner).
# Copia a `.env` y rellena los valores. NUNCA se commitea un `.env` real
# (.gitignore lo excluye, CHECKPOINTS.md §C7).

# --- Forgejo (instancia) ---------------------------------------------------
# Interfaz de escucha. 127.0.0.1 = solo accessible desde esta máquina (DA-3).
FORGEJO_BIND=127.0.0.1

# Puertos. El HTTP es el que el humano abre en el navegador tras levantar.
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=2222

# URL raíz con la que se accede a la instancia. Debe terminar en /.
FORGEJO_ROOT_URL=http://127.0.0.1:3000/

# --- Credenciales (rellenar tras el instalador inicial) --------------------
# El primer usuario registrado obtiene el rol de administrador.
FORGEJO_ADMIN_USUARIO=CHANGE_ME
FORGEJO_ADMIN_PASSWORD=CHANGE_ME

# Token de API generado desde la UI (Settings > Applications > Generate Token).
# Permisos requeridos: repository: Read and Write, admin: Read and Write.
FORGEJO_API_TOKEN=CHANGE_ME

# --- Runner ----------------------------------------------------------------
# Nombre descriptivo del runner (aparece en la UI de Site Administration).
RUNNER_NOMBRE=local-docker

# Etiquetas del runner. El formato es lista YAML en línea.
# La etiqueta por defecto permite ejecutar workflows que usen "runs-on: host".
RUNNER_ETIQUETAS='["host", "docker:docker://node:20"]'
